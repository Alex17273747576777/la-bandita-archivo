{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Ficha de aplicación de la Guía Maestra de La Bandita",
 "type": "object",
 "required": ["id", "nombre", "repo", "autores", "licencia", "nivel", "tarea", "capitulo", "orden",
              "para_quien", "manos", "resultado_esperado", "si_sale_mal", "deshacer", "cabeza",
              "limites", "oficio", "riesgos", "senal", "medido_en", "credito"],
 "properties": {
  "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
  "nombre": {"type": "string"},
  "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
  "autores": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["nombre", "enlace"]}},
  "licencia": {"type": "object", "required": ["spdx", "archivo"],
               "properties": {"spdx": {"type": "string"}, "archivo": {"type": "string", "format": "uri"}}},
  "nivel": {"enum": ["principiante", "intermedio", "experto"]},
  "tarea": {"type": "string", "minLength": 40},
  "capitulo": {"type": "integer", "minimum": 1},
  "orden": {"type": "integer", "minimum": 1},
  "para_quien": {"type": "object", "required": ["es", "no_es"]},
  "manos": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 20}},
  "resultado_esperado": {"type": "string", "minLength": 30},
  "si_sale_mal": {"type": "array", "minItems": 1},
  "deshacer": {"type": "string", "minLength": 30},
  "cabeza": {"type": "array", "minItems": 2},
  "limites": {"type": "array", "minItems": 2},
  "oficio": {"type": "object", "required": ["dato", "como_comprobar", "comando"],
             "properties": {"dato": {"type": "string", "minLength": 80},
                            "como_comprobar": {"type": "string", "minLength": 40},
                            "comando": {"type": "string", "minLength": 3}}},
  "riesgos": {"type": "array", "minItems": 1},
  "alternativas": {"type": "array", "items": {"type": "string"}},
  "senal": {"type": "object", "required": ["estrellas", "nota", "edad_dias", "ultima_entrega",
                                           "descargas_10", "contribuyentes", "repo_mb", "ci", "incidencias"]},
  "medido_en": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "swhid": {"type": ["string", "null"]},
  "credito": {"type": "string", "minLength": 20}
 }
}
