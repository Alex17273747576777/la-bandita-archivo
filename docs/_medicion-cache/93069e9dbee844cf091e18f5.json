ctions%5Bbot%5D/repos", "events_url": "https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}", "received_events_url": "https://api.github.com/users/github-actions%5Bbot%5D/received_events", "type": "Bot", "user_view_type": "public", "site_admin": false}, "content_type": "raw", "state": "uploaded", "size": 123886187, "digest": "sha256:655f1b6f8062859c05fbed51997fdaf7bd8a8b47916d452962ac84c39a373899", "download_count": 285, "created_at": "2026-11-01T15:41:57Z", "updated_at": "2026-11-01T15:42:00Z", "browser_download_url": "https://github.com/kodjodevf/mangayomi/releases/download/v0.9.95/Mangayomi-v0.9.95-macos.dmg"}, {"url": "https://api.github.com/repos/kodjodevf/mangayomi/releases/assets/698743492", "id": 698743492, "node_id": "RA_kwDOJSDBL84ppfrE", "name": "Mangayomi-v0.9.95-windows.exe", "label": "", "uploader": {"login": "github-actions[bot]", "id": 41898282, "node_id": "MDM6Qm90NDE4OTgyODI=", "avatar_url": "https://avatars.githubusercontent.com/in/15368?v=4", "gravatar_id": "", "url": "https://api.github.com/users/github-actions%5Bbot%5D", "html_url": "https://github.com/apps/github-actions", "followers_url": "https://api.github.com/users/github-actions%5Bbot%5D/followers", "following_url": "https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}", "gists_url": "https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}", "starred_url": "https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/github-actions%5Bbot%5D/subscriptions", "organizations_url": "https://api.github.com/users/github-actions%5Bbot%5D/orgs", "repos_url": "https://api.github.com/users/github-actions%5Bbot%5D/repos", "events_url": "https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}", "received_events_url": "https://api.github.com/users/github-actions%5Bbot%5D/received_events", "type": "Bot", "user_view_type": "public", "site_admin": false}, "content_type": "raw", "state": "uploaded", "size": 72249366, "digest": "sha256:ec9dbc76726233baae9689a76d65726b6ced0d2fad36cee8dac0dd37349ffb70", "download_count": 1127, "created_at": "2026-11-01T15:41:54Z", "updated_at": "2026-11-01T15:41:56Z", "browser_download_url": "https://github.com/kodjodevf/mangayomi/releases/download/v0.9.95/Mangayomi-v0.9.95-windows.exe"}, {"url": "https://api.github.com/repos/kodjodevf/mangayomi/releases/assets/698743412", "id": 698743412, "node_id": "RA_kwDOJSDBL84ppfp0", "name": "Mangayomi-v0.9.95-windows.zip", "label": "", "uploader": {"login": "github-actions[bot]", "id": 41898282, "node_id": "MDM6Qm90NDE4OTgyODI=", "avatar_url": "https://avatars.githubusercontent.com/in/15368?v=4", "gravatar_id": "", "url": "https://api.github.com/users/github-actions%5Bbot%5D", "html_url": "https://github.com/apps/github-actions", "followers_url": "https://api.github.com/users/github-actions%5Bbot%5D/followers", "following_url": "https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}", "gists_url": "https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}", "starred_url": "https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/github-actions%5Bbot%5D/subscriptions", "organizations_url": "https://api.github.com/users/github-actions%5Bbot%5D/orgs", "repos_url": "https://api.github.com/users/github-actions%5Bbot%5D/repos", "events_url": "https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}", "received_events_url": "https://api.github.com/users/github-actions%5Bbot%5D/received_events", "type": "Bot", "user_view_type": "public", "site_admin": false}, "content_type": "raw", "state": "uploaded", "size": 99348438, "digest": "sha256:b284fce1eb75dab8c50965ab6d35c6d9a261c0f30f0a4dfe7009d3b4a05d3a1c", "download_count": 430, "created_at": "2026-11-01T15:41:51Z", "updated_at": "2026-11-01T15:41:54Z", "browser_download_url": "https://github.com/kodjodevf/mangayomi/releases/download/v0.9.95/Mangayomi-v0.9.95-windows.zip"}], "tarball_url": "https://api.github.com/repos/kodjodevf/mangayomi/tarball/v0.9.95", "zipball_url": "https://api.github.com/repos/kodjodevf/mangayomi/zipball/v0.9.95", "body": "## Why 0.9.95 and not 1.0.0?\r\n\r\nThis release has almost everything planned for 1.0.0: a new design, a rebuilt player and hundreds of fixes. But so much has changed that it needs testing on more devices and libraries than we can cover ourselves.\r\n\r\nSo 0.9.95 is the last step before 1.0.0. The goal now is stability, not new features. If something breaks or looks wrong, please [open an issue](https://github.com/kodjodevf/mangayomi/issues) with your device and app version. 1.0.0 will come once this version has proven solid.\r\n\r\n## Highlights\r\n\r\n* **Shiori, a new design for the whole app:** every screen has been redrawn on one design system, with new navigation, transitions and an ergonomic pass throughout (#1077).\r\n* **A rebuilt video player:** new controls on phone, desktop and TV, plus video filters, audio delay, and volume, brightness and fit kept between episodes.\r\n* **A tracker with no account:** follow your status, progress, score and dates on the device alone (#1121).\r\n* **Work that keeps going on Android:** downloads, library updates, restores and syncs continue in the background, under one notification (#1092).\r\n* **More control over downloads and updates:** download ahead while reading, download new chapters automatically, and choose which series a library update skips (#1091).\r\n\r\n**Before updating:** this is a large release that also touches how your library is stored, so make a backup first (More > Backup and restore).\r\n\r\n## Reader\r\n\r\n* Zoom with Ctrl (⌘ on macOS) and the mouse wheel; the wheel alone moves a zoomed page.\r\n* With \"Navigate to pan\" on, tall pages are read row by row before the page turns.\r\n* Split tall images into slices in webtoon mode.\r\n* Choose which chapters next and previous skip: read, filtered or duplicate.\r\n* Rebind the reader's keyboard shortcuts.\r\n* Separate icons for crop borders on and off.\r\n* Pages and zooms follow your finger more closely, and the webtoon strip glides after a fling.\r\n* Decoded images now have a memory limit, so long chapters no longer keep growing in memory.\r\n* Fixed: lost decoded pages for the next chapter when closing the reader, and chapter list rows with a scanlator failing to lay out.\r\n\r\n## Video player\r\n\r\n* New controls on phone, desktop and TV, with episodes reachable from the top bar and lock and skip under the timeline on mobile.\r\n* **Video filters:** brightness, contrast, saturation, gamma and hue, kept for the next episodes. Gamma is hidden where the video output cannot apply it.\r\n* **Audio delay:** from -5 to +5 seconds.\r\n* Remember volume and brightness between episodes, and keep the fit from one episode to the next.\r\n* New \"Turn subtitles on\" switch, so episodes can start without subtitles.\r\n* \"Use my subtitle style\" now really gives the default style back when turned off.\r\n* VAAPI and VDPAU hardware decoding on Linux.\r\n* Rebind the player's keyboard shortcuts.\r\n* Fixed: a freeze in the player's event handling, crashes when chapter marks change, previous and next buttons on mobile, and controls under the camera cutout in landscape.\r\n\r\n## Library and browsing\r\n\r\n* Swipe sideways to switch between Manga, Anime and Novels, in the library and in Browse.\r\n* Select everything between two entries, in the library and in chapter lists.\r\n* Skip completed series, series with unread chapters or series not started in library updates. The categories' \"Skip updates\" option now takes effect too.\r\n* The Updates badge counts what was found since you last opened Updates, and clears when you visit.\r\n* Hidden media types are respected everywhere: Browse, Updates, History and the tracker library.\r\n* Browse remembers the Sources or Extensions page picked for each media.\r\n* Recommendation cards use the available space and no longer show HTML tags.\r\n* Fixed: opening Updates and History with orphan chapters, and an empty random entry.\r\n\r\n## Downloads\r\n\r\n* Download the next 2, 3, 5 or 10 unread chapters while reading.\r\n* Download new chapters after a library update.\r\n* \"Delete download after reading\" can remove a chapter 1 to 4 back instead, and keeps bookmarked chapters.\r\n* Failed downloads wait before retrying, and follow what a server asks after a 429 or 503.\r\n* Fixed: complete downloads being held back by the series cover, and resumed archives not finishing.\r\n\r\n## Tracking\r\n\r\n* New on-device tracker, with its own shelf in the tracker library.\r\n* Redrawn tracking card.\r\n* Progress now reaches trackers even if you leave the screen first.\r\n\r\n## Extensions\r\n\r\n* Updates are found in every repository, and the app says which one they come from. An update from another repository asks for confirmation before it is installed.\r\n* Extension WebViews are hosted for the extension server, including network and media capture.\r\n* Faster extension installs.\r\n* Repositories with empty source lists are supported.\r\n* Fixed: sources that read a setting in their headers failing to install, and video qualities lost with multiple hosters.\r\n\r\n## Backup, restore and sync\r\n\r\n* Reading time and last-read dates are kept when restoring backups from other apps.\r\n* Anime is kept from backups of unrecognised forks.\r\n* Local archive favorites are included in backups.\r\n* A backup password is only requested when the password is really the problem.\r\n* Refreshing a catalog keeps your reading state, and duplicate chapters are merged safely.\r\n* Fixed: logging in to the sync server on macOS.\r\n\r\n## Security and privacy\r\n\r\n* **Secure screen:** keep the app out of screenshots and the recent apps preview, always or only in incognito mode.\r\n* **Lock after:** ask to authenticate after 1, 2, 5 or 10 minutes away, or only when the app starts.\r\n\r\n## Updates and first launch\r\n\r\n* Onboarding starts by asking for your language.\r\n* Clearer update dialog: installed and new version, date, size, sorted notes and what happens next. You will see it from the next update onwards.\r\n* Pre-releases are now ordered correctly when checking for updates.\r\n* New open source licenses screen in About.\r\n* New Persian translation, and the missing strings translated in every language.\r\n\r\n## Platforms\r\n\r\n* **Android:** fixed a crash where all files access cannot be granted.\r\n* **Android TV:** fixed the Player settings in the anime-only layout, and the repository added on the welcome screen is filed under anime.\r\n* **iOS:** local files stay inside their folder.\r\n* **macOS:** the app icon now fits the system's icon grid.\r\n* **Windows:** sharper 256 px icon, used by the installer too, and more readable crash reports.\r\n* **Linux:** choose which browser opens external links; JPEG is read whichever libjpeg version is installed; fixed webview window crashes.\r\n\r\n## Stability and performance\r\n\r\n* Faster database queries and lower memory use.\r\n* The next chapter preloads on a new page rather than on every frame.\r\n* A page that lost its data now offers a way back instead of crashing.\r\n* The startup error screen says what to do when the database cannot open.\r\n* Handled errors are now recorded, and developer mode shows them with their details.\r\n\r\n## Contributors\r\n\r\nThanks to everyone who contributed to this release: @adobex, @aliafshany, @itsyaba, @Lukas-DS, @matsukiender-star, @MenaHere, @NBA2K1 and @Totara-thib.\r\n\r\n**Full Changelog**: https://github.com/kodjodevf/mangayomi/compare/v0.9.9...v0.9.95\r\n", "reactions": {"url": "https://api.github.com/repos/kodjodevf/mangayomi/releases/430664787/reactions", "total_count": 11, "+1": 6, "-1": 0, "laugh": 0, "hooray": 2, "confused": 0, "heart": 0, "rocket": 2, "eyes": 1}, "mentions_count": 8}}