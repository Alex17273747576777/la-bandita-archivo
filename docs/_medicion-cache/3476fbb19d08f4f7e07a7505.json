/users/github-actions%5Bbot%5D/following{/other_user}", "gists_url": "https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}", "starred_url": "https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/github-actions%5Bbot%5D/subscriptions", "organizations_url": "https://api.github.com/users/github-actions%5Bbot%5D/orgs", "repos_url": "https://api.github.com/users/github-actions%5Bbot%5D/repos", "events_url": "https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}", "received_events_url": "https://api.github.com/users/github-actions%5Bbot%5D/received_events", "type": "Bot", "user_view_type": "public", "site_admin": false}, "content_type": "application/x-gtar", "state": "uploaded", "size": 7779582, "digest": "sha256:834c51d1f91110e5e7b9ab83818c445a3336343d7f61acdf38db88272b0016ab", "download_count": 7, "created_at": "2026-11-08T19:44:19Z", "updated_at": "2026-11-08T19:44:20Z", "browser_download_url": "https://github.com/ocrmypdf/OCRmyPDF/releases/download/v17.14.0/ocrmypdf-17.14.0.tar.gz"}, {"url": "https://api.github.com/repos/ocrmypdf/OCRmyPDF/releases/assets/725182300", "id": 725182300, "node_id": "RA_kwDOAOn4X84rOWdc", "name": "ocrmypdf-17.14.0.tar.gz.sigstore.json", "label": "", "uploader": {"login": "github-actions[bot]", "id": 41898282, "node_id": "MDM6Qm90NDE4OTgyODI=", "avatar_url": "https://avatars.githubusercontent.com/in/15368?v=4", "gravatar_id": "", "url": "https://api.github.com/users/github-actions%5Bbot%5D", "html_url": "https://github.com/apps/github-actions", "followers_url": "https://api.github.com/users/github-actions%5Bbot%5D/followers", "following_url": "https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}", "gists_url": "https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}", "starred_url": "https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/github-actions%5Bbot%5D/subscriptions", "organizations_url": "https://api.github.com/users/github-actions%5Bbot%5D/orgs", "repos_url": "https://api.github.com/users/github-actions%5Bbot%5D/repos", "events_url": "https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}", "received_events_url": "https://api.github.com/users/github-actions%5Bbot%5D/received_events", "type": "Bot", "user_view_type": "public", "site_admin": false}, "content_type": "application/json", "state": "uploaded", "size": 10937, "digest": "sha256:40b8c3329a089df0502d8d3e321eddf17d07a708faed9f7215c58b23fcb11ff4", "download_count": 4, "created_at": "2026-11-08T21:01:00Z", "updated_at": "2026-11-08T21:01:01Z", "browser_download_url": "https://github.com/ocrmypdf/OCRmyPDF/releases/download/v17.14.0/ocrmypdf-17.14.0.tar.gz.sigstore.json"}], "tarball_url": "https://api.github.com/repos/ocrmypdf/OCRmyPDF/tarball/v17.14.0", "zipball_url": "https://api.github.com/repos/ocrmypdf/OCRmyPDF/zipball/v17.14.0", "body": "**New features**\n\n- New optional OCR engine, RapidOCR, which runs PaddleOCR's PP-OCR models on\n  ONNX Runtime. Install it with `uv tool install 'ocrmypdf[rapidocr]'` (or\n  `uv pip install` / `pip install` with the same extra) and select it with\n  `--ocr-engine rapidocr`. It often reads numbers and table cells more\n  accurately than Tesseract, at a higher CPU and memory cost. It supports\n  `--rotate-pages` and `--deskew` without Tesseract, and the new option\n  `--rapidocr-max-side-len` (API: `rapidocr_max_side_len=`) controls how far\n  large pages are downscaled. See the cookbook for languages and limitations.\n- With RapidOCR, `--rotate-pages` uses PaddlePaddle's PP-LCNet_x1_0_doc_ori\n  page orientation model (6.8 MB, Apache-2.0), downloaded on first use and\n  checked against its checksum, together with the shape of the detected text\n  lines. A page is turned only when both agree.\n- `python -m ocrmypdf.builtin_plugins.rapidocr_ocr download [LANGUAGE...]`\n  downloads RapidOCR's page orientation model and any additional language\n  models in advance, for offline use or container images.\n- The Docker images do not include RapidOCR, to keep them small.\n  `.docker/Dockerfile.rapidocr` builds an image with RapidOCR, its page\n  orientation model and any additional languages on top of the Ubuntu image.\n\n**Fixes**\n\n- Selecting an OCR engine other than Tesseract, including `--ocr-engine\n  none`, no longer requires Tesseract to be installed.\n- Fixed `--redo-ocr` and `--mode strip` removing visible text from a text\n  object that also contains invisible text, such as when the text rendering\n  mode changes to invisible partway through it. Only the invisible text is\n  now removed, and font and spacing settings made where it is removed are\n  kept for the text that follows. {issue}`1769`\n- Fixed the fpdf2 renderer writing the text of a line that rises to the right\n  too large, by up to the height of its rise, which also made the text of\n  neighbouring lines overlap. A sloped line's box spans its rise as well as\n  its text; the text size is now measured at the end of the line where the\n  baseline is highest, as it already was for lines that fall to the right."}}